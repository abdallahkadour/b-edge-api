// 	// Handle typed AppError
// 	if appErr, ok := err.(*AppError); ok {
// 		return c.Status(appErr.HTTPStatus).JSON(fiber.Map{
// 			"data":  nil,
// 			"error": appErr,
// 			"meta":  nil,
// 		})
// 	}

// 	// Handle native Fiber errors (e.g. 404 from router, 405 method not allowed)
// 	if fiberErr, ok := err.(*fiber.Error); ok {
