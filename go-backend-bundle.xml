.blocking-badge{display:inline-flex;align-items:center;gap:4px;font-size:11px;padding:4px 10px;border-radius:20px;font-weight:600}

/* FLOW */
.flow-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.flow-col-title{font-size:16px;font-weight:700;margin-bottom:16px;padding-bottom:10px;border-bottom:2px solid #e5e7eb}
.flow-step{display:flex;gap:14px;margin-bottom:12px}
.flow-num{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0}
.flow-body{flex:1;padding-bottom:12px}
.flow-title{font-size:14px;font-weight:600;margin-bottom:3px}
.flow-detail{font-size:12px;color:#666;line-height:1.5}
.flow-connector{width:2px;height:8px;background:#e5e7eb;margin-left:14px}
.info-card{border-radius:10px;border:1px solid #e5e7eb;padding:14px;margin-bottom:10px;background:#fff}
.info-card.danger{border-color:#fca5a5;background:#fff5f5}
.info-card-title{font-size:13px;font-weight:600;margin-bottom:4px}
.info-card-body{font-size:12px;color:#555;line-height:1.5}

/* CANCELLATION */
.cancel-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}
.cancel-card{border-radius:12px;border:1px solid #e5e7eb;padding:18px;background:#fff}
.cancel-scenario{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#888;margin-bottom:10px}
.cancel-deposit{font-size:14px;margin-bottom:6px}
.cancel-status{font-size:14px;margin-bottom:8px}
