    ${s.to.length
      ?`<div style="font-size:12px;color:#888;margin-bottom:6px">Can transition to:</div><div class="arrows-row">${s.to.map(t=>`<span class="arrow-pill arrow-to">${t} →</span>`).join('')}</div>`
      :`<div class="arrows-row"><span class="arrow-pill" style="background:#fef2f2;color:#991b1b;border-color:#fecaca">Final state — no further transitions possible</span></div>`}
    <div class="detail-rule">${s.rule}</div>
  `;
}

renderGrid();
selectState('held');
</script>
