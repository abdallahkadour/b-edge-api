# Server
PORT=3000
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bedge
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=64_random_hex_chars_minimum
JWT_REFRESH_SECRET=64_different_random_hex_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:4200
ARTIST_DASHBOARD_URL=http://localhost:4300

# Public origins used to build links that leave the server (review and
# booking links sent to customers, the calendar link, salon invitations).
# Each falls back to localhost when unset - harmless in development, and a
# visibly wrong link in production rather than a silently broken one.
# ARTIST_DASHBOARD_URL above is also the base of salon invitation links.
CUSTOMER_PWA_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:3000

# Salon invitations may only go to artists whose phone number is verified.
# Default off: verifying a number means sending it a code, and outbound
# delivery does not work yet (see TWILIO_* below).
REQUIRE_VERIFIED_PHONE_FOR_INVITE=false

# Cloudinary - signed uploads.
# API_SECRET must NEVER be exposed to the frontend. The browser receives
# only a short-lived signature generated from it by GET /media/signature.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio (WhatsApp delivery) - see project-docs/WHATSAPP-SETUP.md.
# Without these, internal/notification/worker.go queues every OTP,
# booking, and review-request message but never actually delivers any of
# them - it logs "twilio not configured" and moves on.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=your_approved_whatsapp_sender_number
# Optional SMS sender. Set either sender or both; with neither set the
# worker fails every message with "no transport configured".
TWILIO_SMS_FROM=

# Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Test
TEST_DB_NAME=bedge_test

# ── Edge / proxy ──────────────────────────────────────────────────────────────
# Read by internal/config/proxy.go. Both were added after this file was last
# updated and were undocumented until the 2026-09-18 release audit.
#
# TRUSTED_PROXIES: comma-separated CIDRs whose forwarded-for header is believed.
# EMPTY MEANS TRUST NOTHING, which is the correct and safe default until the
# app actually sits behind a proxy. Setting it wrongly lets any caller spoof
# their own IP and therefore their own rate-limit bucket and audit trail.
TRUSTED_PROXIES=

# PROXY_HEADER: which header carries the real client IP. Defaults to
# CF-Connecting-IP. Only consulted when TRUSTED_PROXIES is non-empty.
PROXY_HEADER=CF-Connecting-IP
