        if n == "3" and owners == "1":
            rec("23.3", "PASS", "three artists, exactly one owner")
        else:
            rec("23.3", "FAIL", f"artists={n} owners={owners}")

        # Carine narrows her hours. Three artists is where a rota keyed on the
