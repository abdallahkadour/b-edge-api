.sc-badge{font-size:10px;padding:2px 8px;border-radius:10px;margin-top:6px;display:inline-block;font-weight:600}
.detail-panel{border-radius:16px;background:#fff;border:1px solid #e5e7eb;padding:24px;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.detail-name{font-size:22px;font-weight:700;margin-bottom:4px}
