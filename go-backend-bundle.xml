.tag-red{background:#fee2e2;color:#991b1b}
.tag-amber{background:#fef3c7;color:#92400e}
.refund-flow{border-radius:12px;background:#fff;border:1px solid #e5e7eb;padding:20px}
.refund-title{font-size:14px;font-weight:600;margin-bottom:12px}
.refund-steps{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.refund-pill{padding:8px 16px;border-radius:20px;font-size:13px;font-weight:600}

/* ALGORITHM */
.algo-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.algo-card{border-radius:12px;border:1px solid #e5e7eb;padding:20px;background:#fff;position:relative}
.algo-card.special{border-color:#6366f1;background:#fafafa}
