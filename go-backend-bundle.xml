    CHECK (delivery_lat IS NULL OR (delivery_lat BETWEEN -90 AND 90)),
  ADD COLUMN delivery_lng DOUBLE PRECISION
    CHECK (delivery_lng IS NULL OR (delivery_lng BETWEEN -180 AND 180));
