if __name__ == "__main__":
    ap = argparse.ArgumentParser(); ap.add_argument("--api", default=API)
    API = ap.parse_args().api
    print(f"\n  ══ AGGRESSIVE BOOKING CHAOS RUN ══  ({API})")
