.algo-check{display:flex;gap:8px;margin-top:8px;font-size:13px;color:#555}
.algo-check::before{content:'✓';color:#059669;font-weight:700;flex-shrink:0}
.algo-gist{background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:14px;margin-top:12px}
.algo-gist-title{font-size:13px;font-weight:700;color:#1d4ed8;margin-bottom:4px}
.algo-gist-body{font-size:12px;color:#3730a3;line-height:1.5}

/* FOOTER */
footer{background:#1a1a2e;color:rgba(255,255,255,.6);padding:24px 48px;font-size:13px;display:flex;justify-content:space-between;align-items:center;flex-wrap:gap}

