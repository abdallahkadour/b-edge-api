<script>
const states = [
  { id:'held', name:'held', desc:'Slot reserved, 10 min', who:'Customer begins checkout', color:'#7c3aed', bg:'#ede9fe', border:'#c4b5fd', from:[], to:['pending','expired'], blocks:true, rule:'Lasts exactly 10 minutes. The GIST exclusion constraint treats this the same as confirmed — no other customer can book this slot. If the customer does not complete checkout in 10 minutes, a background job expires the hold and the slot is freed immediately.' },
  { id:'pending', name:'pending', desc:'Awaiting artist approval', who:'Customer submits form', color:'#1d4ed8', bg:'#dbeafe', border:'#93c5fd', from:['held'], to:['approved','cancelled'], blocks:true, rule:'Artist receives a WhatsApp notification the moment the booking enters pending status. The artist reviews in their dashboard and must approve or reject. There is no automatic timeout — a booking can stay pending until the artist acts.' },
  { id:'approved', name:'approved', desc:'Approved, awaiting deposit', who:'Artist approves', color:'#0891b2', bg:'#cffafe', border:'#67e8f9', from:['pending'], to:['deposit_paid','expired','cancelled'], blocks:true, rule:'System sets deposit_deadline = appointment_time − 48 hours. Customer is notified via WhatsApp with the deposit amount, Wish Money details, and exact deadline. If the deadline passes without payment, a background job transitions to expired.' },
  { id:'deposit_paid', name:'deposit_paid', desc:'Deposit received', who:'Artist marks deposit received', color:'#0d9488', bg:'#ccfbf1', border:'#5eead4', from:['approved'], to:['confirmed','cancelled'], blocks:true, rule:'Artist verified the Wish Money transfer in their app. Tapped "Mark deposit received." The booking is now in deposit_paid. Artist must then tap "Confirm booking" to finalize — this two-step process prevents accidental confirmations.' },
  { id:'confirmed', name:'confirmed', desc:'Booking confirmed and live', who:'Artist confirms deposit', color:'#059669', bg:'#d1fae5', border:'#6ee7b7', from:['deposit_paid'], to:['completed','no_show','cancelled'], blocks:true, rule:'Both parties receive a WhatsApp confirmation. System schedules automatic 24-hour and 2-hour reminder notifications. The appointment is live and appears in the artist\'s calendar.' },
  { id:'completed', name:'completed', desc:'Service delivered. Final.', who:'Artist marks completed', color:'#374151', bg:'#f8fafc', border:'#e2e8f0', from:['confirmed'], to:[], blocks:false, rule:'Final state. The service was delivered. Customer receives a WhatsApp message with a review link. The booking is preserved forever via soft delete — deleted_at is never set.' },
  { id:'cancelled', name:'cancelled', desc:'Cancelled by either party', who:'Artist or customer cancels', color:'#374151', bg:'#f8fafc', border:'#e2e8f0', from:['pending','approved','deposit_paid','confirmed'], to:[], blocks:false, rule:'If artist cancels: status goes to refund_due (always). If customer cancels >24h before: refund_due. If customer cancels <24h before: cancelled with deposit forfeited. Slot freed immediately in all cases.' },
  { id:'expired', name:'expired', desc:'Deadline passed. Slot released.', who:'Background job', color:'#374151', bg:'#f8fafc', border:'#e2e8f0', from:['held','approved'], to:[], blocks:false, rule:'Two scenarios: (1) Hold expired — customer did not complete checkout in 10 minutes. (2) Deposit deadline passed — customer did not pay the deposit before the 48-hour deadline. In both cases: slot freed immediately, waitlist triggered, customer notified.' },
  { id:'no_show', name:'no_show', desc:'Customer did not arrive', who:'Artist marks no-show', color:'#374151', bg:'#f8fafc', border:'#e2e8f0', from:['confirmed'], to:[], blocks:false, rule:'Final state. Artist marks this in their dashboard after the appointment time. Deposit is forfeited — artist keeps the full deposit. No-show recorded for analytics.' },
  { id:'refund_due', name:'refund_due', desc:'Refund approved, not sent', who:'Artist or customer cancels (with refund)', color:'#b45309', bg:'#fef3c7', border:'#fcd34d', from:['cancelled'], to:['refunded'], blocks:false, rule:'Triggers when: artist cancels (always), or customer cancels >24h before the appointment. Artist sees this in their refund queue. Must transfer the amount via Wish Money and mark as sent.' },
  { id:'refunded', name:'refunded', desc:'Refund sent. Final.', who:'Artist marks refund sent', color:'#374151', bg:'#f8fafc', border:'#e2e8f0', from:['refund_due'], to:[], blocks:false, rule:'Final state. Artist transferred the refund via Wish Money and marked it as sent in the dashboard. Customer receives a WhatsApp confirmation.' },
];

let selected = null;

function renderGrid() {
  const grid = document.getElementById('states-grid');
  grid.innerHTML = states.map(s => `
    <div class="state-card${selected===s.id?' active':''}" onclick="selectState('${s.id}')"
